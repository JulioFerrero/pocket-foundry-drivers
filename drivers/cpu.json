{
  "name": "CPU",
  "kind": "cpu",
  "about": "Mesa's llvmpipe draws on the processor, without the GPU. Slow and hard on the battery: what a game falls back on when no GPU driver works.",
  "madeBy": "Mesa",
  "licence": "MIT",
  "for": "Any GPU",
  "env": {
    "LIBGL_ALWAYS_SOFTWARE": "1", "MESA_LOADER_DRIVER_OVERRIDE": "llvmpipe", "GALLIUM_DRIVER": "llvmpipe",
    "LP_NATIVE_VECTOR_WIDTH": "256", "LP_PERF": "no_mip_linear"
  },
  "source": {
    "git": "https://github.com/lfdevs/mesa-for-android-container",
    "ref": "eb3e7fd4f009cab04b1482aad4843c0bde28a786"
  },
  "build": {
    "packages": ["llvm-19-dev", "libpolly-19-dev"],
    "patches": [
      "patches/mesa-dri-submit-the-frame-before-the-hud.patch",
      "patches/mesa-st-uniform-blocks-with-11-per-stage.patch"
    ],
    "options": [
      "-Dplatforms=x11", "-Dgallium-drivers=llvmpipe", "-Dvulkan-drivers=", "-Dglx=dri", "-Degl=enabled",
      "-Dgbm=disabled", "-Dglvnd=enabled", "-Dgles1=disabled", "-Dgles2=enabled",
      "-Dllvm=enabled", "-Dshared-llvm=disabled", "-Dgallium-va=disabled", "-Dgallium-rusticl=false",
      "-Dteflon=false", "-Dvulkan-layers=[]", "-Dtools=[]", "-Dbuild-tests=false", "-Dhtml-docs=disabled",
      "-Dvalgrind=disabled", "-Dlibunwind=disabled", "-Dlmsensors=disabled", "-Dxlib-lease=disabled",
      "-Dandroid-libbacktrace=disabled", "-Dzstd=enabled", "-Dexpat=enabled"
    ]
  }
}
