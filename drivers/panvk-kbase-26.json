{
  "name": "PanVK-kbase",
  "kind": "vulkan",
  "version": "26.3.1",
  "about": "Mesa's open Vulkan driver for Mali on Arm's kernel driver: zenithblue's universal build, faster than RC3.",
  "madeBy": "zenithblue",
  "licence": "MIT",
  "priority": 1,
  "for": "Mali-G615",
  "gpus": ["*Mali-G615*"],
  "family": {
    "name": "Mali Bifrost and Valhall",
    "gpus": ["*Mali-G52*", "*Mali-G57*", "*Mali-G68*", "*Mali-G72*", "*Mali-G76*", "*Mali-G77*", "*Mali-G78*",
             "*Mali-G310*", "*Mali-G510*", "*Mali-G610*", "*Mali-G615*", "*Mali-G710*", "*Mali-G715*", "*Mali-G720*",
             "*Mali-G725*", "*Mali-G925*"]
  },
  "env": {
    "MESA_VK_WSI_DEBUG": "sw",
    "DRIRC_CONFIGURATION": "pan_enable_vertex_pipeline_stores_atomics=false"
  },
  "compression": "cpu",
  "tested": [
    {"phone": "realme 16 Pro", "gpu": "Mali-G615", "result": "plays", "fps": "60",
     "link": "https://github.com/JulioFerrero/pocket-foundry/issues/35"},
    {"phone": "Xiaomi 14T", "gpu": "Mali-G615 MC6", "android": 14, "version": "26.3.1", "result": "plays",
     "fps": "56-59", "app": "0.8.17-beta.6", "date": "2026-11-10"}
  ],
  "source": {
    "git": "https://github.com/zenithblue-oss/panvk-kbase-android",
    "ref": "panvk-kbase-v26.3.1"
  },
  "build": {
    "packages": ["libclang-19-dev", "libclang-cpp19-dev", "clang-19", "libclc-19-dev", "llvm-spirv-19",
                 "libllvmspirvlib-19-dev", "spirv-tools", "python3-ply"],
    "prepare": [
      "git init -q work/mesa && git -C work/mesa fetch -q --depth 1 https://gitlab.freedesktop.org/mesa/mesa.git 5a07217f034b3e50d8c7c7794f97a2df1742613b && git -C work/mesa checkout -q FETCH_HEAD",
      "sh scripts/prepare-rc5-tree.sh --mesa \"$PWD/work/mesa\""
    ],
    "mesa": "work/mesa",
    "licences": ["NOTICE.md", "LICENSES/MIT.txt"],
    "options": [
      "-Dplatforms=x11", "-Dgallium-drivers=", "-Dvulkan-drivers=panfrost", "-Dpanfrost-kmds=kbase",
      "-Dmesa-clc=enabled", "-Dprecomp-compiler=enabled", "-Dllvm=enabled", "-Dshared-llvm=enabled",
      "-Dglx=disabled", "-Degl=disabled", "-Dgbm=disabled", "-Dgles1=disabled", "-Dgles2=disabled",
      "-Dopengl=false", "-Dvulkan-layers=[]", "-Dtools=[]", "-Dbuild-tests=false", "-Dhtml-docs=disabled",
      "-Dvalgrind=disabled", "-Dlibunwind=disabled", "-Dlmsensors=disabled", "-Dxlib-lease=disabled",
      "-Dzstd=enabled", "-Dexpat=enabled"
    ]
  }
}
