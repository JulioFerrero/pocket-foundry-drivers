{
  "name": "MobileGlues",
  "kind": "gles",
  "version": "2.2.0",
  "about": "The phone's own OpenGL ES driver, without Zink or Vulkan: MobileGL-Dev's MobileGlues, made for Minecraft, turns the game's OpenGL into it, through libhybris. Experimental.",
  "madeBy": "MobileGL-Dev",
  "licence": "LGPL-2.1",
  "for": "Any GPU",
  "priority": 9,
  "settings": [
    {
      "id": "wait",
      "label": "Wait for each frame",
      "about": "Off, the processor draws the next frame while the GPU finishes this one: up to twice as fast on older Malis. On, each frame shows as soon as it's drawn, which can be smoother on a phone already at 60 FPS.",
      "env": {"MGX11_OVERLAP": "0"}
    }
  ],
  "source": {
    "git": "https://github.com/MobileGL-Dev/MobileGlues",
    "ref": "97558a69157b033b890958b1e49258c5b51a80c6"
  },
  "build": {
    "packages": [
      "libvulkan-dev",
      "libx11-dev",
      "libxcb1-dev",
      "libxcb-dri3-dev",
      "libxcb-present-dev"
    ],
    "prepare": [
      "git submodule update --init --depth 1 MobileGlues-cpp/3rdparty/glslang MobileGlues-cpp/3rdparty/SPIRV-Cross MobileGlues-cpp/3rdparty/xxhash MobileGlues-cpp/include/ska"
    ],
    "cmake": "MobileGlues-cpp",
    "patches": [
      "patches/mobileglues-libraries-by-path.patch",
      "patches/mobileglues-bc-read-back.patch",
      "patches/mobileglues-discard-new-storage.patch"
    ],
    "licences": [
      "LICENSE",
      "MobileGlues-cpp/3rdparty/glslang/LICENSE.txt",
      "MobileGlues-cpp/3rdparty/SPIRV-Cross/LICENSE",
      "MobileGlues-cpp/3rdparty/xxhash/LICENSE",
      "MobileGlues-cpp/include/ska/LICENSE"
    ]
  },
  "tested": [
    {
      "phone": "vivo X200 Ultra",
      "gpu": "Adreno 830",
      "android": 16,
      "version": "2.0.0",
      "result": "plays",
      "fps": "59",
      "app": "0.8.18-beta.2",
      "date": "2026-11-12"
    },
    {
      "phone": "Redmi 12",
      "gpu": "Mali-G52 MC2",
      "android": 14,
      "version": "2.0.0",
      "result": "plays",
      "fps": "20-30",
      "app": "0.8.18-beta.3",
      "date": "2026-11-12"
    },
    {
      "phone": "Redmi 12",
      "gpu": "Mali-G52 MC2",
      "android": 14,
      "version": "2.1.0",
      "result": "plays",
      "fps": "45-60",
      "app": "0.8.18-beta.3",
      "date": "2026-11-12"
    },
    {
      "phone": "Galaxy XCover7",
      "gpu": "Mali-G57 MC2",
      "android": 15,
      "version": "2.1.0",
      "result": "plays",
      "fps": "55-60",
      "app": "0.8.18-beta.3",
      "date": "2026-11-12"
    }
  ]
}
