+          pack_alignment = 4, viewport[4] = {};
+    GLES.glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &framebuffer);
+    GLES.glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read_framebuffer);
+    GLES.glGetIntegerv(GL_CURRENT_PROGRAM, &program);
+    GLES.glGetIntegerv(GL_ACTIVE_TEXTURE, &active);
+    GLES.glActiveTexture(GL_TEXTURE0);
+    GLES.glGetIntegerv(GL_TEXTURE_BINDING_2D, &bound);
+    GLES.glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &vertex_array);
+    GLES.glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &pack);
+    GLES.glGetIntegerv(GL_PACK_ALIGNMENT, &pack_alignment);
+    GLES.glGetIntegerv(GL_VIEWPORT, viewport);
+    const GLenum switches[] = {GL_BLEND, GL_SCISSOR_TEST, GL_DEPTH_TEST, GL_STENCIL_TEST, GL_CULL_FACE,
+                               GL_RASTERIZER_DISCARD};
+    GLboolean was[6];
+    for (int i = 0; i < 6; i++) {
+        was[i] = GLES.glIsEnabled(switches[i]);
+        if (was[i]) GLES.glDisable(switches[i]);
