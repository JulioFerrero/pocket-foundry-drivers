+// Whether the driver puts compressed blocks uploaded from a pixel unpack buffer where they belong: checked once, where
+// the encoder is first built. A Pixel 10's PowerVR put them in the wrong places in every level size tried, where the
+// same blocks uploaded from memory landed right. -1 not checked, 0 they land wrong, 1 right.
+std::atomic<int> buffer_uploads{-1};
+
+// A block's colour: its place's number, column and row, so a block drawn elsewhere says where it came from.
+void place_rgb(int place, int bx, int by, uint8_t* o) {
+    const int c = (((place << 2) | (by & 3)) << 11) | ((bx & 63) << 5) | ((by >> 2) & 31);
+    const int r = (c >> 11) & 31, g = (c >> 5) & 63, b = c & 31;
+    o[0] = (uint8_t)(r << 3 | r >> 2);
+    o[1] = (uint8_t)(g << 2 | g >> 4);
+    o[2] = (uint8_t)(b << 3 | b >> 2);
+}
+
+// [w]x[h] texels of [texture] from x0,y0, drawn into an RGBA8 framebuffer and read back into [rgba]; the context's
+// state put back.
