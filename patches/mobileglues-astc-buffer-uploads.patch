+        " 0.0, 1.0); }\n";
+    static const char* fragment = "#version 300 es\nprecision highp float;\nuniform highp sampler2D t;\n"
+        "uniform ivec2 o;\nout vec4 c;\nvoid main() { c = texelFetch(t, o + ivec2(gl_FragCoord.xy), 0); }\n";
+    GLuint shaders[2] = {GLES.glCreateShader(GL_VERTEX_SHADER), GLES.glCreateShader(GL_FRAGMENT_SHADER)};
+    const char* sources[2] = {vertex, fragment};
+    GLuint prog = GLES.glCreateProgram();
+    for (int i = 0; i < 2; i++) {
+        GLES.glShaderSource(shaders[i], 1, &sources[i], nullptr);
+        GLES.glCompileShader(shaders[i]);
+        GLES.glAttachShader(prog, shaders[i]);
+    }
+    GLES.glLinkProgram(prog);
+    for (GLuint shader : shaders) GLES.glDeleteShader(shader);
+    GLuint target = 0, fbo = 0, vao = 0;
+    GLES.glGenTextures(1, &target);
+    GLES.glBindTexture(GL_TEXTURE_2D, target);
+    GLES.glTexStorage2D(GL_TEXTURE_2D, 1, GL_RGBA8, w, h);
+    GLES.glGenFramebuffers(1, &fbo);
+    GLES.glBindFramebuffer(GL_FRAMEBUFFER, fbo);
+    GLES.glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, target, 0);
+    GLES.glUseProgram(prog);
+    GLES.glUniform1i(GLES.glGetUniformLocation(prog, "t"), 0);
+    GLES.glUniform2i(GLES.glGetUniformLocation(prog, "o"), x0, y0);
+    GLES.glBindTexture(GL_TEXTURE_2D, texture);
+    GLES.glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    GLES.glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    GLES.glGenVertexArrays(1, &vao);
+    GLES.glBindVertexArray(vao);
+    GLES.glViewport(0, 0, w, h);
+    GLES.glDrawArrays(GL_TRIANGLES, 0, 3);
+    rgba.assign((size_t)w * h * 4, 0);
+    GLES.glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+    GLES.glPixelStorei(GL_PACK_ALIGNMENT, 4);
+    GLES.glReadPixels(0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, rgba.data());
+    const GLenum error = GLES.glGetError();
+    if (error != GL_NO_ERROR) {
+        char text[48];
+        snprintf(text, sizeof text, "GL error 0x%x drawing it", error);
+        why = text;
+    }
+    GLES.glBindVertexArray((GLuint)vertex_array);
+    GLES.glDeleteVertexArrays(1, &vao);
+    GLES.glUseProgram((GLuint)program);
+    GLES.glDeleteProgram(prog);
+    GLES.glBindFramebuffer(GL_DRAW_FRAMEBUFFER, (GLuint)framebuffer);
+    GLES.glBindFramebuffer(GL_READ_FRAMEBUFFER, (GLuint)read_framebuffer);
+    GLES.glDeleteFramebuffers(1, &fbo);
+    GLES.glDeleteTextures(1, &target);
+    GLES.glBindTexture(GL_TEXTURE_2D, (GLuint)bound);
+    GLES.glActiveTexture((GLenum)active);
+    GLES.glBindBuffer(GL_PIXEL_PACK_BUFFER, (GLuint)pack);
+    GLES.glPixelStorei(GL_PACK_ALIGNMENT, pack_alignment);
+    GLES.glViewport(viewport[0], viewport[1], viewport[2], viewport[3]);
+    for (int i = 0; i < 6; i++)
+        if (was[i]) GLES.glEnable(switches[i]);
+    while (GLES.glGetError() != GL_NO_ERROR) {}
+    return error == GL_NO_ERROR;
+}
+
+// Whether ASTC blocks uploaded from a buffer, at offsets in it as the encoder's are, land where they should in a
+// [W]x[H] level: a strip as wide as the level two block rows down, and two rectangles where the game puts sprites,
+// drawn back. [detail]: the first block that didn't, and where it came from.
+bool buffer_uploads_land(int W, int H, std::string& detail) {
+    struct Place { int x, y, w, h; };
+    const Place places[3] = {{0, 8, W, 8}, {4, 32, 8, 8}, {W / 2 + 4, 64, 140, 108}};
+    GLint bound = 0, unpack = 0;
+    GLES.glGetIntegerv(GL_TEXTURE_BINDING_2D, &bound);
+    GLES.glGetIntegerv(GL_PIXEL_UNPACK_BUFFER_BINDING, &unpack);
+    while (GLES.glGetError() != GL_NO_ERROR) {}
+    GLuint texture = 0, buffer = 0;
+    GLES.glGenTextures(1, &texture);
+    GLES.glBindTexture(GL_TEXTURE_2D, texture);
+    GLES.glBindBuffer(GL_PIXEL_UNPACK_BUFFER, 0);
+    GLES.glCompressedTexImage2D(GL_TEXTURE_2D, 0, GL_COMPRESSED_RGBA_ASTC_4x4_KHR, W, H, 0,
+                                (GLsizei)((size_t)(W / 4) * (H / 4) * 16), nullptr);
+    bool right = GLES.glGetError() == GL_NO_ERROR;
+    if (!right) detail = "the level wasn't made";
+    // Each block one colour, as an ASTC void-extent block.
+    std::vector<uint8_t> blocks;
+    size_t offsets[3];
+    for (int i = 0; i < 3; i++) {
+        offsets[i] = blocks.size() + 16;
+        blocks.resize(offsets[i]);
+        for (int by = 0; by < places[i].h / 4; by++) {
+            for (int bx = 0; bx < places[i].w / 4; bx++) {
+                uint8_t rgb[3];
+                place_rgb(i, bx, by, rgb);
+                const uint32_t words[4] = {0xfffffdfcu, 0xffffffffu, rgb[0] * 257u | (rgb[1] * 257u) << 16,
+                                           rgb[2] * 257u | 0xffffu << 16};
+                blocks.insert(blocks.end(), (const uint8_t*)words, (const uint8_t*)words + 16);
+            }
+        }
+    }
+    GLES.glGenBuffers(1, &buffer);
+    GLES.glBindBuffer(GL_PIXEL_UNPACK_BUFFER, buffer);
+    GLES.glBufferData(GL_PIXEL_UNPACK_BUFFER, (GLsizeiptr)blocks.size(), blocks.data(), GL_STATIC_DRAW);
+    for (int i = 0; i < 3 && right; i++) {
+        const Place& p = places[i];
+        GLES.glCompressedTexSubImage2D(GL_TEXTURE_2D, 0, p.x, p.y, p.w, p.h, GL_COMPRESSED_RGBA_ASTC_4x4_KHR,
+                                       (GLsizei)((size_t)(p.w / 4) * (p.h / 4) * 16), (const void*)offsets[i]);
+        const GLenum error = GLES.glGetError();
+        if (error != GL_NO_ERROR) {
+            char text[64];
+            snprintf(text, sizeof text, "an upload gave GL error 0x%x", error);
+            detail = text;
+            right = false;
+        }
+    }
+    GLES.glBindBuffer(GL_PIXEL_UNPACK_BUFFER, 0);
+    GLES.glDeleteBuffers(1, &buffer);
+    for (int i = 0; i < 3 && right; i++) {
+        const Place& p = places[i];
+        std::vector<uint8_t> drawn;
+        if (!draw_back(texture, p.x, p.y, p.w, p.h, drawn, detail)) {
+            right = false;
+            break;
+        }
+        for (int by = 0; by < p.h / 4 && right; by++) {
+            for (int bx = 0; bx < p.w / 4 && right; bx++) {
+                const uint8_t* g = drawn.data() + ((size_t)(by * 4 + 1) * p.w + bx * 4 + 1) * 4;
+                uint8_t want[3];
+                place_rgb(i, bx, by, want);
+                if (abs(g[0] - want[0]) <= 2 && abs(g[1] - want[1]) <= 2 && abs(g[2] - want[2]) <= 2) continue;
+                const int r5 = g[0] >> 3;
+                char text[200];
+                snprintf(text, sizeof text, "block %d,%d of %dx%d at %d,%d shows %d,%d,%d,%d (place %d's block %d,%d "
+                         "mod 64,128)", bx, by, p.w, p.h, p.x, p.y, g[0], g[1], g[2], g[3], r5 >> 2, g[1] >> 2,
+                         ((g[2] >> 3) << 2) | (r5 & 3));
+                detail = text;
+                right = false;
+            }
+        }
+    }
+    GLES.glDeleteTextures(1, &texture);
+    GLES.glBindTexture(GL_TEXTURE_2D, (GLuint)bound);
+    GLES.glBindBuffer(GL_PIXEL_UNPACK_BUFFER, (GLuint)unpack);
+    while (GLES.glGetError() != GL_NO_ERROR) {}
+    return right;
+}
