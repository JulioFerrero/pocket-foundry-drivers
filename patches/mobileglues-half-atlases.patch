+// Levels kept at half the game's width and height (MG_BC_HALF=1), a quarter of the memory: (texture, level) -> the
+// game's size of it. The game's sprites are drawn by where they are in their atlas as a fraction of it, so a smaller
+// atlas still has them where the game looks, a little softer. Atlases only: the game's sprite sheets are 2048 to 8192
+// wide, and smaller textures stay as they are.
+std::map<std::pair<GLuint, GLint>, std::pair<GLsizei, GLsizei>> halved;
+std::mutex halved_lock;
+const GLsizei HALF_FROM = 1024;
+
+bool half_wanted() {
+    static const bool wanted = [] {
+        const char* v = getenv("MG_BC_HALF");
+        const bool on = v && !strcmp(v, "1");
+        if (on) fprintf(stderr, "MobileGlues BC: atlases kept at half their width and height (MG_BC_HALF=1)\n");
+        return on;
+    }();
+    return wanted;
+}
+
+// A whole level [texture]'s [level] is made, [width]x[height] to the game: whether it's kept at half that, which its
+// level 0 decides for the rest.
+bool halve(GLuint texture, GLint level, GLsizei width, GLsizei height) {
+    if (!half_wanted()) return false;
+    std::lock_guard<std::mutex> guard(halved_lock);
+    const bool half = level == 0 ? width >= HALF_FROM : halved.count({texture, 0}) > 0;
+    if (half) halved[{texture, level}] = {width, height};
+    else halved.erase({texture, level});
+    return half;
+}
