+namespace {
+// Shaders that ask a 2D texture's size (textureSize) or fetch its texels by position (texelFetch) were written for the
+// game's size: Factorio's trees take a pixel position from textureSize and turn it back into a place in the atlas with
+// the size it knows, so with a halved atlas their leaves came from the wrong sprites. Each such sampler gets a shift,
+// mg_half_<name>, 0 unless the texture bound to it is kept at half (then 1), set before each draw (mg_half_draw).
+struct HalfUniform {
+    GLint sampler, shift, last;
+};
+std::map<GLuint, std::set<std::string>> half_shader_samplers;   // shader -> its rewritten samplers
+std::map<GLuint, std::set<std::string>> half_program_samplers;  // program -> its shaders'
+std::map<GLuint, std::vector<HalfUniform>> half_program_uniforms;
+std::mutex half_shader_lock;
+
+bool word_char(char c) { return isalnum((unsigned char)c) || c == '_'; }
+
+// [src] with its textureSize and texelFetch calls of [samplers] made to see the game's size; the ones it changed
+// go into [used].
+std::string half_rewrite(const std::string& src, const std::set<std::string>& samplers, std::set<std::string>& used) {
+    std::string out;
+    out.reserve(src.size());
+    size_t i = 0;
+    while (i < src.size()) {
+        const size_t a = src.find("textureSize", i), b = src.find("texelFetch", i), at = std::min(a, b);
+        if (at == std::string::npos) {
+            out.append(src, i, std::string::npos);
+            break;
+        }
+        const bool size = at == a;
+        const size_t name_end = at + (size ? 11 : 10);
+        size_t open = name_end;
+        while (open < src.size() && isspace((unsigned char)src[open])) open++;
+        if ((at > 0 && word_char(src[at - 1])) || open >= src.size() || src[open] != '(' ||
+            (name_end < src.size() && word_char(src[name_end]))) {
+            out.append(src, i, name_end - i);
+            i = name_end;
+            continue;
+        }
+        // Its arguments, split at the top level.
+        std::vector<std::string> args;
+        int depth = 0;
+        size_t start = open + 1, close = std::string::npos;
+        for (size_t k = open + 1; k < src.size(); k++) {
+            const char c = src[k];
+            if (c == '(') depth++;
+            else if (c == ')' && depth > 0) depth--;
+            else if ((c == ',' || c == ')') && depth == 0) {
+                args.push_back(src.substr(start, k - start));
+                start = k + 1;
+                if (c == ')') {
+                    close = k;
+                    break;
+                }
+            }
+        }
+        std::string name = args.empty() ? "" : args[0];
+        name.erase(0, name.find_first_not_of(" \t\n"));
+        name.erase(name.find_last_not_of(" \t\n") + 1);
+        if (close == std::string::npos || !samplers.count(name) || (!size && args.size() < 2)) {
+            out.append(src, i, name_end - i);
+            i = name_end;
+            continue;
+        }
+        for (size_t k = 1; k < args.size(); k++) args[k] = half_rewrite(args[k], samplers, used);
+        std::string call = (size ? "textureSize(" : "texelFetch(") + args[0];
+        for (size_t k = 1; k < args.size(); k++)
+            call += ", " + (!size && k == 1 ? "((" + args[k] + ") >> mg_half_" + name + ")" : args[k]);
+        call += ")";
+        out.append(src, i, at - i);
+        out += size ? "(" + call + " << mg_half_" + name + ")" : call;
+        used.insert(name);
+        i = close + 1;
+    }
+    return out;
+}
 } // namespace
+
+std::string mg_half_shader(GLuint shader, const std::string& src) {
+    if (!half_wanted()) return src;
+    static const std::regex decl(R"(uniform\s+(?:(?:lowp|mediump|highp)\s+)?sampler2D\s+([A-Za-z_]\w*)\s*;)");
+    std::set<std::string> samplers, used;
+    for (auto it = std::sregex_iterator(src.begin(), src.end(), decl); it != std::sregex_iterator(); ++it)
+        samplers.insert((*it)[1].str());
+    if (samplers.empty() || (src.find("textureSize") == std::string::npos && src.find("texelFetch") == std::string::npos))
+        return src;
+    std::string out = half_rewrite(src, samplers, used);
+    if (used.empty()) return src;
+    // Each shift declared right after its sampler.
+    for (const std::string& name : used) {
+        const std::regex own(R"(uniform\s+(?:(?:lowp|mediump|highp)\s+)?sampler2D\s+)" + name + R"(\s*;)");
+        std::smatch m;
+        if (std::regex_search(out, m, own))
+            out.insert((size_t)(m.position(0) + m.length(0)), "\nuniform int mg_half_" + name + ";");
+    }
+    std::lock_guard<std::mutex> guard(half_shader_lock);
+    half_shader_samplers[shader] = used;
+    return out;
+}
+
+void mg_half_attach(GLuint program, GLuint shader) {
+    if (!half_wanted()) return;
+    std::lock_guard<std::mutex> guard(half_shader_lock);
+    auto found = half_shader_samplers.find(shader);
+    if (found != half_shader_samplers.end()) half_program_samplers[program].insert(found->second.begin(), found->second.end());
+}
+
+void mg_half_link(GLuint program) {
+    if (!half_wanted()) return;
+    std::lock_guard<std::mutex> guard(half_shader_lock);
+    auto found = half_program_samplers.find(program);
+    if (found == half_program_samplers.end()) return;
+    std::vector<HalfUniform> uniforms;
+    for (const std::string& name : found->second) {
+        const GLint sampler = GLES.glGetUniformLocation(program, name.c_str());
+        const GLint shift = GLES.glGetUniformLocation(program, ("mg_half_" + name).c_str());
+        if (sampler >= 0 && shift >= 0) uniforms.push_back({sampler, shift, -1});
+    }
+    half_program_uniforms[program] = uniforms;
+}
+
+void mg_half_draw() {
+    if (!half_wanted() || !gl_state) return;
+    const GLuint program = gl_state->current_program;
+    std::lock_guard<std::mutex> guard(half_shader_lock);
+    auto found = half_program_uniforms.find(program);
+    if (found == half_program_uniforms.end()) return;
+    for (HalfUniform& u : found->second) {
+        GLint unit = 0;
+        GLES.glGetUniformiv(program, u.sampler, &unit);
+        GLuint texture = 0;
+        if (!mg_driver_texture_binding_at_unit(unit, GL_TEXTURE_2D, &texture)) {
+            const int active = mg_driver_active_texture_unit();
+            GLES.glActiveTexture(GL_TEXTURE0 + unit);
+            GLint bound = 0;
+            GLES.glGetIntegerv(GL_TEXTURE_BINDING_2D, &bound);
+            GLES.glActiveTexture(GL_TEXTURE0 + active);
+            texture = (GLuint)bound;
+        }
+        GLsizei w = 0, h = 0;
+        const GLint shift = texture && mg_half_size(texture, 0, &w, &h) ? 1 : 0;
+        if (shift != u.last) {
+            GLES.glUniform1i(u.shift, shift);
+            u.last = shift;
+        }
+    }
+}
 
+bool mg_half_size(GLuint texture, GLint level, GLsizei* width, GLsizei* height) {
+    std::lock_guard<std::mutex> guard(halved_lock);
+    auto found = halved.find({texture, level});
+    if (found == halved.end()) return false;
+    *width = found->second.first;
+    *height = found->second.second;
+    return true;
+}
+
+void mg_half_forget(GLuint texture, GLint level) {
+    std::lock_guard<std::mutex> guard(halved_lock);
+    if (level >= 0) {
+        halved.erase({texture, level});
+        return;
+    }
+    for (auto it = halved.lower_bound({texture, -1}); it != halved.end() && it->first.first == texture;)
+        it = halved.erase(it);
+}
