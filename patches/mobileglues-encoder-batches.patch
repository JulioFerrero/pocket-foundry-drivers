+namespace {
+// This context's encoder buffers, back to nothing: after 3 s without a batch, from the next draw.
+void release_idle() {
+    Encoder& encoder = current();
+    std::lock_guard<std::mutex> guard(encoder.queue_lock);
+    if (!encoder.jobs.empty()) return;
+    GLint storage = 0;
+    GLES.glGetIntegerv(GL_SHADER_STORAGE_BUFFER_BINDING, &storage);
+    for (int k = 0; k < 2; k++) {
+        if (encoder.fence[k]) {
+            GLES.glClientWaitSync(encoder.fence[k], GL_SYNC_FLUSH_COMMANDS_BIT, 2000000000ull);
+            GLES.glDeleteSync(encoder.fence[k]);
+            encoder.fence[k] = nullptr;
+        }
+        GLuint pair[2] = {encoder.in[k], encoder.out[k]};
+        for (GLuint buffer : pair) {
+            if (!buffer) continue;
+            GLES.glBindBuffer(GL_SHADER_STORAGE_BUFFER, buffer);
+            GLES.glBufferData(GL_SHADER_STORAGE_BUFFER, 16, nullptr, GL_DYNAMIC_DRAW);
+        }
+        encoder.in_size[k] = encoder.out_size[k] = 16;
+    }
+    GLES.glBindBuffer(GL_SHADER_STORAGE_BUFFER, (GLuint)storage);
+    buffers_held = false;
+}
+} // namespace
