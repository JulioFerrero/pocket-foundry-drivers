+// A 4x4 block of [format] made into a texture, drawn into a 4x4 RGBA8 framebuffer and read back: right when each
+// texel is within 8 of what decode() makes of it (GPUs round BC's in-between colours each their own way). Logged
+// either way, with the first wrong texel. The context's state is put back.
+bool drawn_right(GLenum format) {
+    // Every index of each block used, its colours far apart: a red-green BC1, a blue-yellow one with transparent
+    // texels, red-blue under BC2's sixteen alphas, green-blue under BC3's eight, and BC4's eight reds and greens.
+    static const uint8_t colour_rg[8] = {0x00, 0xF8, 0xE0, 0x07, 0xE4, 0x1B, 0x4E, 0xB1};
+    static const uint8_t colour_by[8] = {0x1F, 0x00, 0xE0, 0xFF, 0xE4, 0x1B, 0x4E, 0xB1};
+    static const uint8_t colour_rb[8] = {0x00, 0xF8, 0x1F, 0x00, 0xE4, 0x1B, 0x4E, 0xB1};
+    static const uint8_t colour_gb[8] = {0xE0, 0x07, 0x1F, 0x00, 0x1B, 0xE4, 0xB1, 0x4E};
+    static const uint8_t alpha_bc2[8] = {0x10, 0x32, 0x54, 0x76, 0x98, 0xBA, 0xDC, 0xFE};
+    static const uint8_t ramp[8] = {0xFF, 0x00, 0x88, 0xC6, 0xFA, 0x88, 0xC6, 0xFA};
+    static const uint8_t ramp_down[8] = {0x10, 0xE0, 0xFA, 0x88, 0xC6, 0xFA, 0x88, 0xC6};
+    std::vector<uint8_t> block;
+    const char* name = "?";
+    auto add = [&](const uint8_t* bytes) { block.insert(block.end(), bytes, bytes + 8); };
+    switch (format) {
+    case GL_COMPRESSED_RGB_S3TC_DXT1_EXT: name = "BC1"; add(colour_rg); break;
+    case GL_COMPRESSED_RGBA_S3TC_DXT1_EXT: name = "BC1 with alpha"; add(colour_by); break;
+    case GL_COMPRESSED_RGBA_S3TC_DXT3_EXT: name = "BC2"; add(alpha_bc2); add(colour_rb); break;
+    case GL_COMPRESSED_RGBA_S3TC_DXT5_EXT: name = "BC3"; add(ramp); add(colour_gb); break;
+    case GL_COMPRESSED_RED_RGTC1: name = "BC4"; add(ramp); break;
+    case GL_COMPRESSED_RG_RGTC2: name = "BC5"; add(ramp); add(ramp_down); break;
+    default: return false;
+    }
+    Level l;
+    l.format = format;
+    l.width = l.height = 4;
+    std::vector<uint8_t> expected;
+    if (!decode(l, block, expected)) return false;
+
+    // The state this changes.
+    GLint framebuffer = 0, read_framebuffer = 0, program = 0, texture = 0, active = 0, vertex_array = 0, unpack = 0,
+          pack = 0, pack_alignment = 4, viewport[4] = {};
+    GLES.glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &framebuffer);
+    GLES.glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read_framebuffer);
+    GLES.glGetIntegerv(GL_CURRENT_PROGRAM, &program);
+    GLES.glGetIntegerv(GL_ACTIVE_TEXTURE, &active);
+    GLES.glActiveTexture(GL_TEXTURE0);
+    GLES.glGetIntegerv(GL_TEXTURE_BINDING_2D, &texture);
+    GLES.glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &vertex_array);
+    GLES.glGetIntegerv(GL_PIXEL_UNPACK_BUFFER_BINDING, &unpack);
+    GLES.glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &pack);
+    GLES.glGetIntegerv(GL_PACK_ALIGNMENT, &pack_alignment);
+    GLES.glGetIntegerv(GL_VIEWPORT, viewport);
+    const GLenum switches[] = {GL_BLEND, GL_SCISSOR_TEST, GL_DEPTH_TEST, GL_STENCIL_TEST, GL_CULL_FACE,
+                               GL_RASTERIZER_DISCARD};
+    GLboolean was[6];
+    for (int i = 0; i < 6; i++) {
+        was[i] = GLES.glIsEnabled(switches[i]);
+        if (was[i]) GLES.glDisable(switches[i]);
+    }
+    const GLenum earlier = GLES.glGetError();
+    while (GLES.glGetError() != GL_NO_ERROR) {}
+
+    std::string result;
+    GLuint tex = 0, target = 0, fbo = 0, vao = 0, prog = 0;
+    GLES.glBindBuffer(GL_PIXEL_UNPACK_BUFFER, 0);
+    GLES.glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+    GLES.glGenTextures(1, &tex);
+    GLES.glBindTexture(GL_TEXTURE_2D, tex);
+    GLES.glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    GLES.glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    // Made as the game makes its atlases, storage then blocks, and as an empty level, as glTexImage2D's are.
+    auto failed = [&](const char* what) {
+        const GLenum error = GLES.glGetError();
+        if (error == GL_NO_ERROR || !result.empty()) return;
+        char text[96];
+        snprintf(text, sizeof text, "the driver won't %s (GL error 0x%x)", what, error);
+        result = text;
+    };
+    GLES.glTexStorage2D(GL_TEXTURE_2D, 1, format, 4, 4);
+    failed("make storage of it");
+    if (result.empty()) {
+        GLES.glCompressedTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, 4, 4, format, (GLsizei)block.size(), block.data());
+        failed("take its blocks");
+    }
+    if (result.empty()) {
+        GLuint empty = 0;
+        GLES.glGenTextures(1, &empty);
+        GLES.glBindTexture(GL_TEXTURE_2D, empty);
+        GLES.glCompressedTexImage2D(GL_TEXTURE_2D, 0, format, 4, 4, 0, (GLsizei)block.size(), nullptr);
+        failed("make an empty level of it");
+        GLES.glDeleteTextures(1, &empty);
+    }
+    GLenum error = GL_NO_ERROR;
+    if (result.empty()) {
+        GLES.glGenTextures(1, &target);
+        GLES.glBindTexture(GL_TEXTURE_2D, target);
+        GLES.glTexStorage2D(GL_TEXTURE_2D, 1, GL_RGBA8, 4, 4);
+        GLES.glGenFramebuffers(1, &fbo);
+        GLES.glBindFramebuffer(GL_FRAMEBUFFER, fbo);
+        GLES.glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, target, 0);
+        if (GLES.glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) result = "no framebuffer to draw it in";
+    }
+    if (result.empty()) {
+        static const char* vertex = "#version 300 es\n"
+            "void main() { gl_Position = vec4(float((gl_VertexID & 1) << 2) - 1.0, float((gl_VertexID & 2) << 1) - 1.0,"
+            " 0.0, 1.0); }\n";
+        static const char* fragment = "#version 300 es\nprecision highp float;\nuniform highp sampler2D t;\n"
+            "out vec4 c;\nvoid main() { c = texelFetch(t, ivec2(gl_FragCoord.xy), 0); }\n";
+        GLuint shaders[2] = {GLES.glCreateShader(GL_VERTEX_SHADER), GLES.glCreateShader(GL_FRAGMENT_SHADER)};
+        const char* sources[2] = {vertex, fragment};
+        prog = GLES.glCreateProgram();
+        for (int i = 0; i < 2; i++) {
+            GLES.glShaderSource(shaders[i], 1, &sources[i], nullptr);
+            GLES.glCompileShader(shaders[i]);
+            GLES.glAttachShader(prog, shaders[i]);
+        }
+        GLES.glLinkProgram(prog);
+        for (GLuint shader : shaders) GLES.glDeleteShader(shader);
+        GLint linked = 0;
+        GLES.glGetProgramiv(prog, GL_LINK_STATUS, &linked);
+        if (!linked) result = "its program didn't link";
+    }
+    if (result.empty()) {
+        GLES.glUseProgram(prog);
+        GLES.glUniform1i(GLES.glGetUniformLocation(prog, "t"), 0);
+        GLES.glBindTexture(GL_TEXTURE_2D, tex);
+        GLES.glGenVertexArrays(1, &vao);
+        GLES.glBindVertexArray(vao);
+        GLES.glViewport(0, 0, 4, 4);
+        GLES.glDrawArrays(GL_TRIANGLES, 0, 3);
+        uint8_t drawn[64] = {};
+        GLES.glPixelStorei(GL_PACK_ALIGNMENT, 4);
+        GLES.glReadPixels(0, 0, 4, 4, GL_RGBA, GL_UNSIGNED_BYTE, drawn);
+        error = GLES.glGetError();
+        if (error != GL_NO_ERROR) {
+            char text[64];
+            snprintf(text, sizeof text, "drawing it failed (GL error 0x%x)", error);
+            result = text;
+        }
+        for (int t = 0; t < 16 && result.empty(); t++) {
+            for (int c = 0; c < 4; c++) {
+                if (abs((int)drawn[t * 4 + c] - (int)expected[t * 4 + c]) <= 8) continue;
+                char text[160];
+                snprintf(text, sizeof text, "it draws wrong: texel %d is %d,%d,%d,%d where it's %d,%d,%d,%d", t,
+                         drawn[t * 4], drawn[t * 4 + 1], drawn[t * 4 + 2], drawn[t * 4 + 3], expected[t * 4],
+                         expected[t * 4 + 1], expected[t * 4 + 2], expected[t * 4 + 3]);
+                result = text;
+                break;
+            }
+        }
+    }
+    const bool right = result.empty();
+    fprintf(stderr, "MobileGlues BC: %s, drawn by the driver: %s\n", name, right ? "right" : result.c_str());
+
+    GLES.glBindVertexArray((GLuint)vertex_array);
+    if (vao) GLES.glDeleteVertexArrays(1, &vao);
+    GLES.glUseProgram((GLuint)program);
+    if (prog) GLES.glDeleteProgram(prog);
+    GLES.glBindFramebuffer(GL_DRAW_FRAMEBUFFER, (GLuint)framebuffer);
+    GLES.glBindFramebuffer(GL_READ_FRAMEBUFFER, (GLuint)read_framebuffer);
+    if (fbo) GLES.glDeleteFramebuffers(1, &fbo);
+    GLuint textures[2] = {tex, target};
+    GLES.glDeleteTextures(2, textures);
+    GLES.glBindTexture(GL_TEXTURE_2D, (GLuint)texture);
+    GLES.glActiveTexture((GLenum)active);
+    GLES.glBindBuffer(GL_PIXEL_UNPACK_BUFFER, (GLuint)unpack);
+    GLES.glBindBuffer(GL_PIXEL_PACK_BUFFER, (GLuint)pack);
+    GLES.glPixelStorei(GL_PACK_ALIGNMENT, pack_alignment);
+    GLES.glViewport(viewport[0], viewport[1], viewport[2], viewport[3]);
+    for (int i = 0; i < 6; i++)
+        if (was[i]) GLES.glEnable(switches[i]);
+    while (GLES.glGetError() != GL_NO_ERROR) {}
+    if (earlier != GL_NO_ERROR) mg_set_gl_error(earlier);
+    return right;
 }
 
