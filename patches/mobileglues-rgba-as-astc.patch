+// A texture about to be a framebuffer's attachment: one kept as ASTC goes back to RGBA first.
+void mg_rgba_attach(GLuint texture) {
+    if (!texture) return;
+    std::lock_guard<std::mutex> guard(lock);
+    rgba_back(texture);
+}
