 extern "C" {
 
+// glTexImage2D of an empty RGBA8 level of a big texture (rgba_textures): made as ASTC here. False leaves it to the
+// driver.
+bool mg_rgba_image(GLenum target, GLint level, GLint internalformat, GLsizei width, GLsizei height, GLenum format,
+                   GLenum type, const void* pixels) {
+    if (target != GL_TEXTURE_2D || pixels || (internalformat != GL_RGBA && internalformat != GL_RGBA8) ||
+        format != GL_RGBA || type != GL_UNSIGNED_BYTE || !rgba_wanted())
+        return false;
+    GLint unpack = 0;
+    GLES.glGetIntegerv(GL_PIXEL_UNPACK_BUFFER_BINDING, &unpack);
+    if (unpack) return false;   // pixels is an offset into it: not empty
+    const GLuint texture = bound_2d();
+    std::lock_guard<std::mutex> guard(lock);
+    rgba_pending.erase({texture, level});
+    if (level == 0 && width < RGBA_FROM) {
+        rgba_back(texture);
+        return false;
+    }
+    if (rgba_textures.count(texture)) return rgba_level(texture, level, width, height);
+    // Not kept as ASTC until it's uploaded to: made as the game asked, for now.
+    if (level == 0 || rgba_pending.count({texture, 0})) rgba_pending[{texture, level}] = {width, height};
+    return false;
+}
+
+// glTexSubImage2D into a level kept as ASTC: into its copy, and the blocks it touches encoded again, 64 rows at a
+// time. False leaves it to the driver.
+bool mg_rgba_sub_image(GLenum target, GLint level, GLint x, GLint y, GLsizei width, GLsizei height, GLenum format,
+                       GLenum type, const void* pixels) {
+    if (target != GL_TEXTURE_2D || width <= 0 || height <= 0) return false;
+    const GLuint texture = bound_2d();
+    std::lock_guard<std::mutex> guard(lock);
+    if (rgba_pending.count({texture, level}) && format == GL_RGBA && type == GL_UNSIGNED_BYTE) {
+        // Its first upload: every level made so far, kept as ASTC from now on.
+        bool all = true;
+        for (auto it = rgba_pending.lower_bound({texture, -1}); it != rgba_pending.end() && it->first.first == texture;) {
+            all = all && rgba_level(texture, it->first.second, it->second.first, it->second.second);
+            it = rgba_pending.erase(it);
+        }
+        if (all) rgba_textures.insert(texture);
+        else rgba_back(texture);
+    }
+    auto found = shadows.find({texture, level});
+    if (found == shadows.end() || found->second.format != GL_RGBA8) return false;
+    if (format != GL_RGBA || type != GL_UNSIGNED_BYTE) {
+        // Not what the copy holds: the texture goes back to RGBA, and the driver takes it.
+        rgba_back(texture);
+        return false;
+    }
+    Level& l = found->second;
+    GLint row_length = 0, skip_rows = 0, skip_pixels = 0, alignment = 4;
+    GLES.glGetIntegerv(GL_UNPACK_ROW_LENGTH, &row_length);
+    GLES.glGetIntegerv(GL_UNPACK_SKIP_ROWS, &skip_rows);
+    GLES.glGetIntegerv(GL_UNPACK_SKIP_PIXELS, &skip_pixels);
+    GLES.glGetIntegerv(GL_UNPACK_ALIGNMENT, &alignment);
+    if (alignment < 1) alignment = 1;
+    const size_t stride = ((size_t)(row_length > 0 ? row_length : width) * 4 + alignment - 1) / alignment * alignment;
+    const size_t first = (size_t)skip_rows * stride + (size_t)skip_pixels * 4;
+    const size_t span = first + (size_t)(height - 1) * stride + (size_t)width * 4;
+    const int w = std::min(width, l.width - x), h = std::min(height, l.height - y);
+    if (w <= 0 || h <= 0) return true;
+    const int level_bw = (l.width + 3) / 4, level_bh = (l.height + 3) / 4;
+    const int bx0 = x / 4, bx1 = std::min(level_bw, (x + w + 3) / 4);
+    const int by0 = y / 4, by1 = std::min(level_bh, (y + h + 3) / 4);
+    const int bw = bx1 - bx0, tx0 = bx0 * 4, tw = std::min(bw * 4, l.width - tx0);
+    // On whole blocks (Fast start's cache loads a level at once), they come from the upload itself; else the copy has
+    // the texels around it.
+    const bool whole = x % 4 == 0 && y % 4 == 0 && (w % 4 == 0 || x + w == l.width) && (h % 4 == 0 || y + h == l.height);
+    std::vector<uint8_t> rows, blocks;
+    source(pixels, span, [&](const uint8_t* bytes) {
+        for (int r = 0; r < h; r++)
+            write_blocks(l, ((size_t)(y + r) * l.width + x) * 4, bytes + first + (size_t)r * stride, (size_t)w * 4);
+        for (int band = by0; band < by1; band += 16) {
+            const int bh = std::min(16, by1 - band), ty0 = band * 4, th = std::min(bh * 4, l.height - ty0);
+            const uint8_t* from;
+            size_t from_stride;
+            if (whole) {
+                from = bytes + first + (size_t)(ty0 - y) * stride;
+                from_stride = stride;
+            } else {
+                if (!read_texels(l, tx0, ty0, tw, th, rows)) break;
+                from = rows.data();
+                from_stride = (size_t)tw * 4;
+            }
+            blocks.resize((size_t)bw * bh * 64);
+            for (int ty = 0; ty < bh * 4; ty++) {
+                const uint8_t* row = from + (size_t)std::min(ty, th - 1) * from_stride;   // past the edge: the last again
+                for (int bx = 0; bx < bw; bx++) {
+                    uint8_t* block = blocks.data() + (((size_t)(ty / 4) * bw + bx) * 16 + (ty % 4) * 4) * 4;
+                    const int sx = bx * 4;
+                    if (sx + 4 <= tw) memcpy(block, row + (size_t)sx * 4, 16);
+                    else
+                        for (int k = 0; k < 4; k++) memcpy(block + k * 4, row + (size_t)std::min(sx + k, tw - 1) * 4, 4);
+                }
+            }
+            mg_astc_upload(target, level, tx0, ty0, tw, th, GL_RGBA8, blocks.data(), blocks.size(), false);
+        }
+    });
+    return true;
+}
