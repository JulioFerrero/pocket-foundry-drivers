+
+// Big RGBA textures kept as ASTC 4x4 (MG_RGBA_ASTC=0 leaves them RGBA). Factorio keeps its icons uncompressed ("not-
+// compressed"): an RGBA8 atlas 8192 wide and its mipmaps, made empty and filled from memory, a sprite at a time
+// anywhere, never drawn into. As ASTC it's a quarter of the memory: each upload goes into an RGBA copy on storage, and
+// the 4x4 blocks it touches are encoded again from the copy. A texture 4096 wide or more, made empty, is kept as ASTC
+// at its first upload: the game also makes a 4096x4096 RGBA texture it only draws into and reads back. One drawn into
+// after all goes back to RGBA from its copy.
+std::set<GLuint> rgba_textures;   // kept as ASTC
+std::map<std::pair<GLuint, GLint>, std::pair<GLsizei, GLsizei>> rgba_pending;   // made empty, not yet uploaded to
+const GLsizei RGBA_FROM = 4096;
+
+bool rgba_wanted() {
+    static const bool on = [] {
+        const char* v = getenv("MG_RGBA_ASTC");
+        const bool yes = !(v && !strcmp(v, "0"));
+        fprintf(stderr, "MobileGlues: big RGBA textures (the icons) %s\n", yes ? "kept as ASTC 4x4" : "left RGBA (MG_RGBA_ASTC=0)");
+        return yes;
+    }();
+    return on;
+}
+
+// [w]x[h] texels of an RGBA level's copy from x, y, row after row.
+bool read_texels(const Level& l, int x, int y, int w, int h, std::vector<uint8_t>& out) {
+    const size_t row = (size_t)w * 4;
+    out.resize(row * h);
+    for (int r = 0; r < h; r++) {
+        const size_t at = ((size_t)(y + r) * l.width + x) * 4;
+        if (at + row > l.size) return false;
+        if (l.offset < 0) {
+            memcpy(out.data() + r * row, l.memory.data() + at, row);
+            continue;
+        }
+        for (size_t done = 0; done < row;) {
+            ssize_t n = pread(store, out.data() + r * row + done, row - done, l.offset + (off_t)(at + done));
+            if (n <= 0) return false;
+            done += n;
+        }
+    }
+    return true;
 }
 
+// [texture]'s levels kept as ASTC, back to RGBA from their copies: it's drawn into. Under [lock].
+void rgba_back(GLuint texture) {
+    for (auto it = rgba_pending.lower_bound({texture, -1}); it != rgba_pending.end() && it->first.first == texture;)
+        it = rgba_pending.erase(it);
+    if (!rgba_textures.erase(texture)) return;
+    mg_astc_flush_for(texture, -1);
+    GLint bound = 0, unpack = 0, row_length = 0, skip_rows = 0, skip_pixels = 0, alignment = 4;
+    GLES.glGetIntegerv(GL_TEXTURE_BINDING_2D, &bound);
+    GLES.glGetIntegerv(GL_PIXEL_UNPACK_BUFFER_BINDING, &unpack);
+    GLES.glGetIntegerv(GL_UNPACK_ROW_LENGTH, &row_length);
+    GLES.glGetIntegerv(GL_UNPACK_SKIP_ROWS, &skip_rows);
+    GLES.glGetIntegerv(GL_UNPACK_SKIP_PIXELS, &skip_pixels);
+    GLES.glGetIntegerv(GL_UNPACK_ALIGNMENT, &alignment);
+    GLES.glBindTexture(GL_TEXTURE_2D, texture);
+    GLES.glBindBuffer(GL_PIXEL_UNPACK_BUFFER, 0);
+    GLES.glPixelStorei(GL_UNPACK_ROW_LENGTH, 0);
+    GLES.glPixelStorei(GL_UNPACK_SKIP_ROWS, 0);
+    GLES.glPixelStorei(GL_UNPACK_SKIP_PIXELS, 0);
+    GLES.glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+    for (auto it = shadows.lower_bound({texture, -1}); it != shadows.end() && it->first.first == texture;) {
+        if (it->second.format != GL_RGBA8) { ++it; continue; }
+        std::vector<uint8_t> texels;
+        read_blocks(it->second, texels);
+        GLES.glTexImage2D(GL_TEXTURE_2D, it->first.second, GL_RGBA8, it->second.width, it->second.height, 0, GL_RGBA,
+                          GL_UNSIGNED_BYTE, texels.data());
+        it = shadows.erase(it);
+    }
+    fprintf(stderr, "MobileGlues: texture %u is drawn into: back to RGBA from its copy\n", texture);
+    GLES.glBindTexture(GL_TEXTURE_2D, (GLuint)bound);
+    GLES.glBindBuffer(GL_PIXEL_UNPACK_BUFFER, (GLuint)unpack);
+    GLES.glPixelStorei(GL_UNPACK_ROW_LENGTH, row_length);
+    GLES.glPixelStorei(GL_UNPACK_SKIP_ROWS, skip_rows);
+    GLES.glPixelStorei(GL_UNPACK_SKIP_PIXELS, skip_pixels);
+    GLES.glPixelStorei(GL_UNPACK_ALIGNMENT, alignment);
+}
+
+// [texture]'s [level], the bound texture's, made again as an empty ASTC level with an RGBA copy. Under [lock].
+bool rgba_level(GLuint texture, GLint level, GLsizei width, GLsizei height) {
+    if (!mg_astc_upload(GL_TEXTURE_2D, level, 0, 0, width, height, GL_RGBA8, nullptr, 0, true)) return false;
+    Level l;
+    l.format = GL_RGBA8;
+    l.width = width;
+    l.height = height;
+    allocate(l);
+    shadows[{texture, level}] = std::move(l);
+    return true;
+}
