+++ b/MobileGlues-cpp/gl/bc_astc.h
@@ -0,0 +1,27 @@
+// Pocket Foundry patch for MobileGlues (LGPL-2.1): BC1-BC3 kept as ASTC 4x4 (bc_astc.cpp).
+#ifndef MOBILEGLUES_BC_ASTC_H
+#define MOBILEGLUES_BC_ASTC_H
+
+#include <GLES3/gl32.h>
+#include <cstddef>
+#include <cstdint>
+
+// The ASTC 4x4 format BC1, BC2 or BC3 [bc] is kept as, else 0.
+GLenum mg_astc_for(GLenum bc);
+
+// Whether this thread's context can: OpenGL ES 3.1's compute shaders, ASTC, and the encoder built.
+bool mg_astc_ready();
+
+// [blocks] (size bytes), [width]x[height] texels of [bc], encoded on the GPU into the bound texture's [level] with the
+// next batch: at x, y, or the whole level when [whole], which is made at once. No blocks: an empty level, transparent.
+// False when it couldn't.
+bool mg_astc_upload(GLenum target, GLint level, GLint x, GLint y, GLsizei width, GLsizei height, GLenum bc,
+                    const uint8_t* blocks, size_t size, bool whole);
+
+// The uploads waiting for a batch, done: before anything can draw with or read their textures.
+void mg_astc_flush();
+
+// The same, only if some are for [texture]'s [level] (any level when negative): before it's remade or deleted.
+void mg_astc_flush_for(GLuint texture, GLint level);
+
+#endif
