+// Pocket Foundry patch for MobileGlues (LGPL-2.1): BC1-BC3 textures kept as ASTC 4x4 where OpenGL ES has ASTC and no
+// BC (Mali, PowerVR). A compute shader decodes each BC block as bc_shadow.cpp's CPU decoder does and encodes it again
+// with the ASTC encoder of taowen/libhybris' Vulkan compat layer (bc_astc_encoder.inc, MIT), which keeps BC1-BC3
+// colour almost exactly: 8 bits a texel, where the RGBA8 that bc_shadow.cpp decodes into otherwise takes 32.
+#include "../includes.h"
+#include <GL/gl.h>
+#include "glcorearb.h"
+#include "log.h"
+#include "../gles/loader.h"
+#include "mg.h"
+#include "bc_astc.h"
+#include "../egl/context.h"
+#include <cstdio>
+#include <cstring>
+#include <atomic>
+#include <map>
+#include <mutex>
+#include <vector>
+#include <string>
+
+#ifndef GL_COMPRESSED_RGB_S3TC_DXT1_EXT
+#define GL_COMPRESSED_RGB_S3TC_DXT1_EXT 0x83F0
+#define GL_COMPRESSED_RGBA_S3TC_DXT1_EXT 0x83F1
+#define GL_COMPRESSED_RGBA_S3TC_DXT3_EXT 0x83F2
+#define GL_COMPRESSED_RGBA_S3TC_DXT5_EXT 0x83F3
+#endif
+#ifndef GL_COMPRESSED_SRGB_S3TC_DXT1_EXT
+#define GL_COMPRESSED_SRGB_S3TC_DXT1_EXT 0x8C4C
+#define GL_COMPRESSED_SRGB_ALPHA_S3TC_DXT1_EXT 0x8C4D
+#define GL_COMPRESSED_SRGB_ALPHA_S3TC_DXT3_EXT 0x8C4E
+#define GL_COMPRESSED_SRGB_ALPHA_S3TC_DXT5_EXT 0x8C4F
+#endif
+#ifndef GL_COMPRESSED_RGBA_ASTC_4x4_KHR
+#define GL_COMPRESSED_RGBA_ASTC_4x4_KHR 0x93B0
+#define GL_COMPRESSED_SRGB8_ALPHA8_ASTC_4x4_KHR 0x93D0
+#endif
+
+namespace {
+
+#include "bc_astc_encoder.inc"
+
+// One invocation a 4x4 block. u_kind: BC1 without alpha (0) or with (1), BC2 (2), BC3 (3), or none (4): an empty
+// level, transparent black, where an ASTC block of zeros would be the decoder's error colour.
+const char kHeader[] = R"GLSL(#version 310 es
+precision highp float;
+precision highp int;
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(std430, binding = 0) readonly buffer Src { uint w[]; } src;
+layout(std430, binding = 1) writeonly buffer Dst { uvec4 b[]; } dst;
+layout(location = 0) uniform uvec2 u_blocks;
+layout(location = 1) uniform uint u_kind;
+layout(location = 2) uniform uint u_src;   /* the job's first word in src */
+layout(location = 3) uniform uint u_dst;   /* and its first block in dst */
+const uint BC_QUALITY = 1u;
+ivec4 g_px[16];
+)GLSL";
+
+const char kDecoder[] = R"GLSL(
+ivec3 rgb565(uint c)
+{
+    ivec3 v = ivec3(int((c >> 11) & 31u), int((c >> 5) & 63u), int(c & 31u));
+    return ivec3((v.r << 3) | (v.r >> 2), (v.g << 2) | (v.g >> 4), (v.b << 3) | (v.b >> 2));
+}
+
+/* bc_shadow.cpp's bc1(): four colours, or three and black, transparent unless rgb */
+void colour(uint c01, uint indices, bool four, bool rgb)
+{
+    uint c0 = c01 & 0xffffu, c1 = c01 >> 16;
+    ivec3 a = rgb565(c0), b = rgb565(c1);
+    ivec4 p[4];
+    p[0] = ivec4(a, 255);
+    p[1] = ivec4(b, 255);
+    if (four || c0 > c1) {
+        p[2] = ivec4((2 * a + b) / 3, 255);
+        p[3] = ivec4((a + 2 * b) / 3, 255);
+    } else {
+        p[2] = ivec4((a + b) / 2, 255);
+        p[3] = ivec4(0, 0, 0, rgb ? 255 : 0);
+    }
+    for (uint t = 0u; t < 16u; t++) g_px[t] = p[(indices >> (2u * t)) & 3u];
+}
+
+void alpha_bc2(uint w0, uint w1)
+{
+    for (uint t = 0u; t < 16u; t++)
+        g_px[t].a = int(((t < 8u ? w0 >> (4u * t) : w1 >> (4u * (t - 8u))) & 15u) * 17u);
+}
+
+/* bc_shadow.cpp's bc4(), into alpha: 3-bit indices from bit 16 of the 64-bit block */
+void alpha_bc3(uint w0, uint w1)
+{
+    int a0 = int(w0 & 0xffu), a1 = int((w0 >> 8) & 0xffu);
+    int p[8];
+    p[0] = a0;
+    p[1] = a1;
+    if (a0 > a1) {
+        for (int k = 1; k <= 6; k++) p[k + 1] = ((7 - k) * a0 + k * a1) / 7;
+    } else {
+        for (int k = 1; k <= 4; k++) p[k + 1] = ((5 - k) * a0 + k * a1) / 5;
+        p[6] = 0;
+        p[7] = 255;
+    }
+    for (uint t = 0u; t < 16u; t++) {
+        uint at = 16u + 3u * t;
+        uint v = at >= 32u ? w1 >> (at - 32u) : (w0 >> at) | (at > 29u ? w1 << (32u - at) : 0u);
+        g_px[t].a = p[v & 7u];
+    }
+}
+
+void main()
+{
+    uvec2 at = gl_GlobalInvocationID.xy;
+    if (at.x >= u_blocks.x || at.y >= u_blocks.y) return;
+    uint i = at.y * u_blocks.x + at.x;
+    if (u_kind == 4u) {
+        dst.b[u_dst + i] = uvec4(0xfffffdfcu, 0xffffffffu, 0u, 0u);
+        return;
+    }
+    /* Copied out first: Mali's compiler refuses a read-only buffer's words as function arguments ("Function call
+     * discards 'readonly' access qualifier"). */
+    if (u_kind < 2u) {
+        uint s = u_src + 2u * i;
+        uint c01 = src.w[s], indices = src.w[s + 1u];
+        colour(c01, indices, false, u_kind == 0u);
+    } else {
+        uint s = u_src + 4u * i;
+        uint a0 = src.w[s], a1 = src.w[s + 1u], c01 = src.w[s + 2u], indices = src.w[s + 3u];
+        colour(c01, indices, true, true);
+        if (u_kind == 2u) alpha_bc2(a0, a1);
+        else alpha_bc3(a0, a1);
+    }
+    dst.b[u_dst + i] = astc_encode(~0u, false);
+}
+)GLSL";
+
+unsigned kind_of(GLenum bc) {
+    switch (bc) {
+    case GL_COMPRESSED_RGB_S3TC_DXT1_EXT:
+    case GL_COMPRESSED_SRGB_S3TC_DXT1_EXT:
+        return 0;
+    case GL_COMPRESSED_RGBA_S3TC_DXT1_EXT:
+    case GL_COMPRESSED_SRGB_ALPHA_S3TC_DXT1_EXT:
+        return 1;
+    case GL_COMPRESSED_RGBA_S3TC_DXT3_EXT:
+    case GL_COMPRESSED_SRGB_ALPHA_S3TC_DXT3_EXT:
+        return 2;
+    default:
+        return 3;
+    }
+}
+
+// One upload: [src_word] and [dst_block] are where its blocks are in the encoder's buffers.
+struct Job {
+    GLuint texture;
+    GLenum target, astc;
+    GLint level, x, y;
+    GLsizei width, height;
+    unsigned kind;
+    GLuint bw, bh;
+    size_t src_word, dst_block;
+    bool whole;
+};
+
+struct Encoder {
+    int ready = -1;   // -1: not tried yet
+    GLuint program = 0, in = 0, out = 0;
+    // Uploads waiting for a batch: an upload from a buffer the GPU still writes waits for the GPU, 1.7 ms each on an
+    // Adreno 830, and building the atlases makes 35,000 small ones (60 s). Run before anything can use them.
+    std::mutex queue_lock;
+    std::vector<uint8_t> staged;
+    std::vector<Job> jobs;
+    size_t blocks = 0;
+};
+// A program and buffers belong to the contexts of one share group: made in the one MobileGlues starts in, they
+// weren't the game's (its dispatches failed with GL_INVALID_OPERATION).
+std::map<unsigned long long, Encoder> encoders;   // a std::map: an entry stays where it is as others come
+std::mutex encoders_lock;
+size_t encoded = 0, reported = 0;
+std::atomic<int> queued{0};   // jobs waiting, in every encoder
+
+Encoder& current() {
+    std::lock_guard<std::mutex> guard(encoders_lock);
+    return encoders[g_current_ctx && g_current_ctx->share_group ? g_current_ctx->share_group->id : 0];
+}
+
+bool has_astc() {
+    GLint major = 0, minor = 0;
+    GLES.glGetIntegerv(GL_MAJOR_VERSION, &major);
+    GLES.glGetIntegerv(GL_MINOR_VERSION, &minor);
+    if (major < 3 || (major == 3 && minor < 1)) return false;   // no compute shaders
+    if (major > 3 || minor >= 2) return true;                  // ASTC LDR is part of OpenGL ES 3.2
+    GLint count = 0;
+    GLES.glGetIntegerv(GL_NUM_EXTENSIONS, &count);
+    for (GLint i = 0; i < count; i++) {
+        const char* name = (const char*)GLES.glGetStringi(GL_EXTENSIONS, i);
+        if (name && !strcmp(name, "GL_KHR_texture_compression_astc_ldr")) return true;
+    }
+    return false;
+}
+
+bool build(Encoder& encoder) {
+    if (!has_astc()) {
+        fprintf(stderr, "MobileGlues BC: no ASTC or no compute shaders, so BC is decoded to RGBA8\n");
+        return false;
+    }
+    const std::string source = std::string(kHeader) + kAstcEncoder + kDecoder;
+    const char* text = source.c_str();
+    GLuint shader = GLES.glCreateShader(GL_COMPUTE_SHADER);
+    GLES.glShaderSource(shader, 1, &text, nullptr);
+    GLES.glCompileShader(shader);
+    GLint ok = 0;
+    GLES.glGetShaderiv(shader, GL_COMPILE_STATUS, &ok);
+    char log[2048] = "";
+    if (!ok) {
+        GLES.glGetShaderInfoLog(shader, sizeof log, nullptr, log);
+        fprintf(stderr, "MobileGlues BC: the ASTC encoder didn't compile, so BC is decoded to RGBA8: %s\n", log);
+        GLES.glDeleteShader(shader);
+        return false;
+    }
+    GLuint program = GLES.glCreateProgram();
+    GLES.glAttachShader(program, shader);
+    GLES.glLinkProgram(program);
+    GLES.glDeleteShader(shader);
+    GLES.glGetProgramiv(program, GL_LINK_STATUS, &ok);
+    if (!ok) {
+        GLES.glGetProgramInfoLog(program, sizeof log, nullptr, log);
+        fprintf(stderr, "MobileGlues BC: the ASTC encoder didn't link, so BC is decoded to RGBA8: %s\n", log);
+        GLES.glDeleteProgram(program);
+        return false;
+    }
+    encoder.program = program;
+    GLES.glGenBuffers(1, &encoder.in);
+    GLES.glGenBuffers(1, &encoder.out);
+    static bool said = false;
+    if (!said) fprintf(stderr, "MobileGlues BC: BC1-BC3 kept as ASTC 4x4, encoded on the GPU\n");
+    said = true;
+    return true;
+}
+
+} // namespace
+
+GLenum mg_astc_for(GLenum bc) {
+    switch (bc) {
+    case GL_COMPRESSED_RGB_S3TC_DXT1_EXT:
+    case GL_COMPRESSED_RGBA_S3TC_DXT1_EXT:
+    case GL_COMPRESSED_RGBA_S3TC_DXT3_EXT:
+    case GL_COMPRESSED_RGBA_S3TC_DXT5_EXT:
+        return GL_COMPRESSED_RGBA_ASTC_4x4_KHR;
+    case GL_COMPRESSED_SRGB_S3TC_DXT1_EXT:
+    case GL_COMPRESSED_SRGB_ALPHA_S3TC_DXT1_EXT:
+    case GL_COMPRESSED_SRGB_ALPHA_S3TC_DXT3_EXT:
+    case GL_COMPRESSED_SRGB_ALPHA_S3TC_DXT5_EXT:
+        return GL_COMPRESSED_SRGB8_ALPHA8_ASTC_4x4_KHR;
+    default:
+        return 0;
+    }
+}
+
+bool mg_astc_ready() {
+    Encoder& encoder = current();
+    if (encoder.ready < 0) encoder.ready = build(encoder);
+    return encoder.ready;
+}
+
+namespace {
+
+// [jobs]' blocks, [staged], to the GPU, a dispatch each, then each into its texture: one wait for the GPU for all.
+void run(const Encoder& encoder, const std::vector<Job>& jobs, const uint8_t* staged, size_t staged_bytes,
+         size_t blocks) {
+    // The game's state, put back after.
+    GLint program = 0, unpack = 0, storage = 0, texture = 0, bound[2] = {};
+    GLint64 start[2] = {}, length[2] = {};
+    GLES.glGetIntegerv(GL_CURRENT_PROGRAM, &program);
+    GLES.glGetIntegerv(GL_PIXEL_UNPACK_BUFFER_BINDING, &unpack);
+    GLES.glGetIntegerv(GL_SHADER_STORAGE_BUFFER_BINDING, &storage);
+    GLES.glGetIntegerv(GL_TEXTURE_BINDING_2D, &texture);
+    for (GLuint i = 0; i < 2; i++) {
+        GLES.glGetIntegeri_v(GL_SHADER_STORAGE_BUFFER_BINDING, i, &bound[i]);
+        GLES.glGetInteger64i_v(GL_SHADER_STORAGE_BUFFER_START, i, &start[i]);
+        GLES.glGetInteger64i_v(GL_SHADER_STORAGE_BUFFER_SIZE, i, &length[i]);
+    }
+    // So the errors below are these uploads'.
+    while (GLES.glGetError() != GL_NO_ERROR) {}
+
+    GLES.glBindBuffer(GL_SHADER_STORAGE_BUFFER, encoder.in);
+    // Empty levels only: nothing to read, but a storage buffer can't be bound with no size.
+    const bool empty = !staged || staged_bytes == 0;
+    GLES.glBufferData(GL_SHADER_STORAGE_BUFFER, empty ? 16 : (GLsizeiptr)staged_bytes, empty ? nullptr : staged,
+                      GL_STREAM_DRAW);
+    GLES.glBindBuffer(GL_SHADER_STORAGE_BUFFER, encoder.out);
+    GLES.glBufferData(GL_SHADER_STORAGE_BUFFER, (GLsizeiptr)(blocks * 16), nullptr, GL_STREAM_COPY);
+    GLES.glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 0, encoder.in);
+    GLES.glBindBufferBase(GL_SHADER_STORAGE_BUFFER, 1, encoder.out);
+    GLES.glUseProgram(encoder.program);
+    for (const Job& job : jobs) {
+        GLES.glUniform2ui(0, job.bw, job.bh);
+        GLES.glUniform1ui(1, job.kind);
+        GLES.glUniform1ui(2, (GLuint)job.src_word);
+        GLES.glUniform1ui(3, (GLuint)job.dst_block);
+        GLES.glDispatchCompute((job.bw + 7) / 8, (job.bh + 7) / 8, 1);
+    }
+    GLES.glMemoryBarrier(GL_PIXEL_BUFFER_BARRIER_BIT);
+
+    // The game's bindings back before the uploads: an Adreno refuses (GL_INVALID_OPERATION) a compressed upload from
+    // a buffer that's still bound as a storage buffer.
+    GLES.glUseProgram((GLuint)program);
+    for (GLuint i = 0; i < 2; i++) {
+        if (length[i] > 0) GLES.glBindBufferRange(GL_SHADER_STORAGE_BUFFER, i, (GLuint)bound[i], start[i], length[i]);
+        else GLES.glBindBufferBase(GL_SHADER_STORAGE_BUFFER, i, (GLuint)bound[i]);
+    }
+    GLES.glBindBuffer(GL_SHADER_STORAGE_BUFFER, (GLuint)storage);
+    GLES.glBindBuffer(GL_PIXEL_UNPACK_BUFFER, encoder.out);
+    GLuint bound_texture = (GLuint)texture;
+    size_t failed = 0;
+    for (const Job& job : jobs) {
+        if (job.texture != bound_texture) GLES.glBindTexture(GL_TEXTURE_2D, bound_texture = job.texture);
+        const GLsizei size = (GLsizei)job.bw * (GLsizei)job.bh * 16;
+        const void* offset = (const void*)(job.dst_block * 16);
+        if (job.whole)
+            GLES.glCompressedTexImage2D(job.target, job.level, job.astc, job.width, job.height, 0, size, offset);
+        else
+            GLES.glCompressedTexSubImage2D(job.target, job.level, job.x, job.y, job.width, job.height, job.astc, size,
+                                           offset);
+        const GLenum error = GLES.glGetError();
+        if (error != GL_NO_ERROR && failed++ < 3)
+            fprintf(stderr, "MobileGlues BC: ASTC upload %dx%d at %d,%d level %d of texture %u: GL error 0x%x\n",
+                    job.width, job.height, job.x, job.y, job.level, job.texture, error);
+        if (error == GL_NO_ERROR) encoded += size;
+    }
+    if (bound_texture != (GLuint)texture) GLES.glBindTexture(GL_TEXTURE_2D, (GLuint)texture);
+    GLES.glBindBuffer(GL_PIXEL_UNPACK_BUFFER, (GLuint)unpack);
+    if (encoded - reported >= (64u << 20)) {
+        reported = encoded;
+        fprintf(stderr, "MobileGlues BC: %zu MB of ASTC so far\n", encoded >> 20);
+    }
+}
+
+void flush(Encoder& encoder) {
+    if (encoder.jobs.empty()) return;
+    run(encoder, encoder.jobs, encoder.staged.data(), encoder.staged.size(), encoder.blocks);
+    queued -= (int)encoder.jobs.size();
+    encoder.jobs.clear();
+    encoder.staged.clear();
+    encoder.blocks = 0;
+}
+
+} // namespace
+
+bool mg_astc_upload(GLenum target, GLint level, GLint x, GLint y, GLsizei width, GLsizei height, GLenum bc,
+                    const uint8_t* blocks, size_t size, bool whole) {
+    const GLenum astc = mg_astc_for(bc);
+    const unsigned kind = blocks ? kind_of(bc) : 4;
+    const GLuint bw = (GLuint)(width + 3) / 4, bh = (GLuint)(height + 3) / 4;
+    const size_t in_bytes = blocks ? (size_t)bw * bh * (kind < 2 ? 8 : 16) : 0;
+    if (!astc || !mg_astc_ready() || (blocks && size < in_bytes)) return false;
+    Encoder& encoder = current();
+    GLint texture = 0;
+    GLES.glGetIntegerv(GL_TEXTURE_BINDING_2D, &texture);
+    std::lock_guard<std::mutex> guard(encoder.queue_lock);
+    Job job{(GLuint)texture, target, astc, level, x, y, width, height, kind, bw, bh, 0, 0, whole};
+    if (whole) {
+        // A level made, or remade. What's waiting for it goes first. The level is made now, its blocks come with the
+        // batch: Factorio makes some 3,000 while loading, and each made at once waited for the GPU. Where the driver
+        // won't make an ASTC level without data, it's made at once, and the caller learns whether that worked.
+        for (const Job& queued_job : encoder.jobs) {
+            if (queued_job.texture == job.texture && queued_job.level == level) {
+                flush(encoder);
+                break;
+            }
+        }
+        GLint unpack = 0;
+        GLES.glGetIntegerv(GL_PIXEL_UNPACK_BUFFER_BINDING, &unpack);
+        if (unpack) GLES.glBindBuffer(GL_PIXEL_UNPACK_BUFFER, 0);
+        while (GLES.glGetError() != GL_NO_ERROR) {}
+        GLES.glCompressedTexImage2D(target, level, astc, width, height, 0, (GLsizei)((size_t)bw * bh * 16), nullptr);
+        const bool made = GLES.glGetError() == GL_NO_ERROR;
+        if (unpack) GLES.glBindBuffer(GL_PIXEL_UNPACK_BUFFER, (GLuint)unpack);
+        if (!made) {
+            const size_t before = encoded;
+            run(encoder, {job}, blocks, in_bytes, (size_t)bw * bh);
+            return encoded > before;
+        }
+        job.whole = false;
+    }
+    job.src_word = encoder.staged.size() / 4;
+    job.dst_block = encoder.blocks;
+    encoder.staged.insert(encoder.staged.end(), blocks, blocks + in_bytes);
+    encoder.blocks += (size_t)bw * bh;
+    encoder.jobs.push_back(job);
+    queued++;
+    if (encoder.staged.size() >= (16u << 20) || encoder.jobs.size() >= 4096) flush(encoder);
+    return true;
+}
+
+void mg_astc_flush() {
+    if (queued.load() == 0) return;
+    Encoder& encoder = current();
+    std::lock_guard<std::mutex> guard(encoder.queue_lock);
+    flush(encoder);
+}
+
+void mg_astc_flush_for(GLuint texture, GLint level) {
+    if (queued.load() == 0) return;
+    Encoder& encoder = current();
+    std::lock_guard<std::mutex> guard(encoder.queue_lock);
+    for (const Job& job : encoder.jobs) {
+        if (job.texture == texture && (level < 0 || job.level == level)) {
+            flush(encoder);
+            return;
+        }
+    }
+}
+
+// Draws, dispatches and glFinish, which MobileGlues hands straight to the driver: the waiting uploads first. Not
+// glFlush: Factorio's sprite loader flushes after each upload, and the queue runs before the next draw anyway; there,
+// every upload was a batch of its own that waited for the GPU (1,622 of them loading the atlases from the cache).
+extern "C" {
+GLAPI GLAPIENTRY void glDrawArrays(GLenum mode, GLint first, GLsizei count) {
+    mg_astc_flush();
+    GLES.glDrawArrays(mode, first, count);
+}
+
+GLAPI GLAPIENTRY void glDrawArraysInstanced(GLenum mode, GLint first, GLsizei count, GLsizei instancecount) {
+    mg_astc_flush();
+    GLES.glDrawArraysInstanced(mode, first, count, instancecount);
+}
+
+GLAPI GLAPIENTRY void glDrawArraysIndirect(GLenum mode, const void* indirect) {
+    mg_astc_flush();
+    GLES.glDrawArraysIndirect(mode, indirect);
+}
+
+GLAPI GLAPIENTRY void glDrawElementsIndirect(GLenum mode, GLenum type, const void* indirect) {
+    mg_astc_flush();
+    GLES.glDrawElementsIndirect(mode, type, indirect);
+}
+
+GLAPI GLAPIENTRY void glDispatchComputeIndirect(GLintptr indirect) {
+    mg_astc_flush();
+    GLES.glDispatchComputeIndirect(indirect);
+}
+
+GLAPI GLAPIENTRY void glFinish() {
+    mg_astc_flush();
+    GLES.glFinish();
+}
+}
