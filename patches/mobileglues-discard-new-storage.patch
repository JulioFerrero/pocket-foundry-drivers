@@ -207,6 +214,18 @@ size_t get_buffer_data_size(GLuint buffer) {
     return 0;
 }
 
+static void set_buffer_orphaned(GLuint buffer, bool orphaned) {
+    ensure_buffer_capacity(buffer);
+    g_buffer_orphaned[buffer] = orphaned;
+}
+
+// Whether the buffer was orphaned and not written since; it no longer counts as orphaned after this.
+static bool take_buffer_orphaned(GLuint buffer) {
+    if (buffer >= g_buffer_orphaned.size() || !g_buffer_orphaned[buffer]) return false;
+    g_buffer_orphaned[buffer] = 0;
+    return true;
+}
+
 static inline int binding_target_to_index(GLenum target) {
     switch (target) {
     case GL_ARRAY_BUFFER:
@@ -1018,6 +1037,7 @@ void glBufferData(GLenum target, GLsizeiptr size, const void* data, GLenum usage
