+    set_buffer_orphaned(find_bound_buffer_by_target(target), !data);
     CHECK_GL_ERROR
 }
 
@@ -1028,6 +1048,15 @@ void glBufferSubData(GLenum target, GLintptr offset, GLsizeiptr size, const void
     LOG_D("glBufferSubData, target = %s, offset = %p, size = %zi", glEnumToString(target), (void*)offset, size)
     borrowed_target_t t(target);
     GLES.glBufferSubData(t.target, offset, size, data);
+    set_buffer_orphaned(find_bound_buffer_by_target(target), false);
+    CHECK_GL_ERROR
+}
+
+void glCopyBufferSubData(GLenum readTarget, GLenum writeTarget, GLintptr readOffset, GLintptr writeOffset,
+                         GLsizeiptr size) {
+    LOG()
+    GLES.glCopyBufferSubData(readTarget, writeTarget, readOffset, writeOffset, size);
+    set_buffer_orphaned(find_bound_buffer_by_target(writeTarget), false);
     CHECK_GL_ERROR
 }
 
@@ -1042,6 +1071,7 @@ void glGetBufferParameteriv(GLenum target, GLenum pname, GLint* params) {
 void* glMapBuffer(GLenum target, GLenum access) {
     LOG()
     LOG_D("glMapBuffer, target = %s, access = %s", glEnumToString(target), glEnumToString(access))
+    take_buffer_orphaned(find_bound_buffer_by_target(target));
     if (g_gles_caps.GL_OES_mapbuffer) {
         borrowed_target_t t(target);
         return GLES.glMapBufferOES(t.target, access);
@@ -1089,6 +1119,14 @@ extern "C"
 
 void* glMapBufferRange(GLenum target, GLintptr offset, GLsizeiptr length, GLbitfield access) {
     LOG()
+    // Factorio gives its vertex buffers new storage with glBufferData(NULL) at the start of each frame, then appends
+    // to them with maps that don't wait for the GPU. On an Adreno 830, with the GPU still drawing the frame before,
+    // those writes landed in the storage it was reading: sprites from elsewhere in the atlases and black squares on
+    // the ground. The first map after new storage discards the whole buffer instead, which the driver answers with
+    // fresh memory; nothing in the buffer was valid anyway.
+    if (take_buffer_orphaned(find_bound_buffer_by_target(target)) && (access & GL_MAP_UNSYNCHRONIZED_BIT) &&
+        !(access & GL_MAP_READ_BIT))
+        access = (access & ~GL_MAP_UNSYNCHRONIZED_BIT) | GL_MAP_INVALIDATE_BUFFER_BIT;
     if (global_settings.buffer_coherent_as_flush) access &= ~GL_MAP_FLUSH_EXPLICIT_BIT;
     //    access |= GL_MAP_UNSYNCHRONIZED_BIT;
     borrowed_target_t t(target);
