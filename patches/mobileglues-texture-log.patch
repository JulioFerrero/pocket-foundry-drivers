+
+// A texture level the driver made, or couldn't ([error]), by [how]: logged when it failed or is big (16 MB and up),
+// with what MobileGlues made before it, so a report says which of the game's textures wasn't made and why (#65: a
+// Pixel 10's PowerVR left three atlases unmade and no line said so). [levels] for glTexStorage2D's, from [level].
+void mg_tex_made(const char* how, GLenum target, GLint level, GLint levels, GLenum requested, GLenum stored,
+                 GLsizei width, GLsizei height, GLenum error) {
+    const GLuint texture = target == GL_TEXTURE_2D ? bound_2d() : 0;
+    size_t bytes = 0;
+    for (GLint l = 0; l < std::max(levels, 1); l++) bytes += texture_bytes(stored, width >> l, height >> l);
+    size_t total, count;
+    {
+        std::lock_guard<std::mutex> guard(made_lock);
+        if (error == GL_NO_ERROR && texture) {
+            auto& slot = made[{texture, level}];
+            made_bytes += bytes - slot;
+            slot = bytes;
+        }
+        total = made_bytes;
+        count = made.size();
+    }
+    if (error == GL_NO_ERROR && bytes < (16u << 20)) return;
+    char failed[32] = "";
+    if (error != GL_NO_ERROR) snprintf(failed, sizeof(failed), ": GL error 0x%x", error);
+    fprintf(stderr, "MobileGlues: texture %u level %d %s by %s: %dx%d, %d level%s, as 0x%x (the game asked 0x%x), "
+            "%zu MB%s; %zu MB in %zu texture levels made so far\n", texture, level,
+            error == GL_NO_ERROR ? "made" : "NOT made", how, width, height, std::max(levels, 1), levels > 1 ? "s" : "",
+            stored, requested, bytes >> 20, failed, total >> 20, count);
 }
 
