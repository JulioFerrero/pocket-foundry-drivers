+// The bound texture's [level] as the driver has it, for the log: "0x0" for one never made.
+std::string driver_level(GLenum target, GLint level) {
+    GLint width = 0, height = 0, internal = 0;
+    GLES.glGetTexLevelParameteriv(target, level, GL_TEXTURE_WIDTH, &width);
+    GLES.glGetTexLevelParameteriv(target, level, GL_TEXTURE_HEIGHT, &height);
+    GLES.glGetTexLevelParameteriv(target, level, GL_TEXTURE_INTERNAL_FORMAT, &internal);
+    char out[96];
+    snprintf(out, sizeof(out), "%dx%d as 0x%x%s", width, height, internal, width ? "" : " (never made)");
+    return out;
+}
+
+// What MobileGlues has made of textures, by texture and level, in bytes: a texture that can't be made is logged
+// with how much was made before it. Kept apart from the shadows' lock: made from texture.cpp too.
+std::mutex made_lock;
+std::map<std::pair<GLuint, GLint>, size_t> made;
+size_t made_bytes = 0;
+
+size_t texture_bytes(GLenum format, GLsizei width, GLsizei height) {
+    const size_t w = (size_t)std::max(width, 1), h = (size_t)std::max(height, 1);
+    if (const int bb = block_bytes(format)) return (w + 3) / 4 * ((h + 3) / 4) * bb;
+    switch (format) {
+    case 0x93B0: case 0x93D0: return (w + 3) / 4 * ((h + 3) / 4) * 16;   // ASTC 4x4
+    case GL_R8: case GL_RED: return w * h;
+    case GL_RG8: case GL_RG: return w * h * 2;
+    case GL_RGB8: case GL_SRGB8: case GL_RGB: return w * h * 3;
+    default: return w * h * 4;
+    }
+}
