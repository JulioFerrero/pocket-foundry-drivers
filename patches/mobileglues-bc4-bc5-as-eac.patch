+// EAC R11 (Khronos Data Format Specification, ETC2's "R11 EAC"): a block is a base codeword, a multiplier and one of
+// 16 modifier sets, and each texel one of its set's eight modifiers: 8 * base + 4 + modifier * 8 * multiplier, clamped
+// to 0..2047 (a multiplier of 0 counts as 1/8). Every set is tried at five multipliers around the one that spans the
+// block's values, with the base that centres it, and the closest of those again a base either side: as close as trying
+// every base around each (shadow edges, BC4's full 0-255 ramps, 0.5 off of 255; gradients 0.8), at a third of the
+// tries, each without branches (a slower search made Factorio's sprite loading take twice as long on a Mali-G610).
+const char kEac[] = R"GLSL(
+/* The sets' four magnitudes, a nibble each from the smallest: modifiers 0-3 are their negatives, 4-7 one less. */
+const uint EAC_SETS[16] = uint[16](0xF963u, 0xDA73u, 0xD852u, 0xD642u, 0xC863u, 0xB973u, 0xB874u, 0xB853u,
+                                   0xA862u, 0xA852u, 0xA842u, 0xA752u, 0xA743u, 0xA321u, 0x9864u, 0x9753u);
+
+vec4 eac_magnitudes(uint set)
+{
+    return vec4((uvec4(set) >> uvec4(0u, 4u, 8u, 12u)) & 15u);
+}
+
+/* What [base], [multiplier] and [set] decode to: modifiers 0-3 in [neg], 4-7 in [pos]. */
+void eac_values(int base, int multiplier, uint set, out vec4 neg, out vec4 pos)
+{
+    float centre = float(base * 8 + 4), step = multiplier == 0 ? 1.0 : float(multiplier * 8);
+    vec4 m = eac_magnitudes(set);
+    neg = clamp(vec4(centre) - m * step, 0.0, 2047.0);
+    pos = clamp(vec4(centre) + (m - 1.0) * step, 0.0, 2047.0);
+}
+
+float eac_nearest(float v, vec4 neg, vec4 pos)
+{
+    vec4 a = vec4(v) - neg, b = vec4(v) - pos;
+    vec4 d = min(a * a, b * b);
+    return min(min(d.x, d.y), min(d.z, d.w));
+}
+
+float eac_row(vec4 r, vec4 neg, vec4 pos)
+{
+    return eac_nearest(r.x, neg, pos) + eac_nearest(r.y, neg, pos) + eac_nearest(r.z, neg, pos) +
+           eac_nearest(r.w, neg, pos);
+}
+
+/* g_eac's squared error as [base], [multiplier] and [set] would give it. */
+float eac_error(int base, int multiplier, uint set)
+{
+    vec4 neg, pos;
+    eac_values(base, multiplier, set, neg, pos);
+    return eac_row(g_eac[0], neg, pos) + eac_row(g_eac[1], neg, pos) + eac_row(g_eac[2], neg, pos) +
+           eac_row(g_eac[3], neg, pos);
+}
+
+uint eac_bytes(uint v)   /* a block's word as it lies in memory: EAC is big-endian */
+{
+    return (v >> 24) | ((v >> 8) & 0xff00u) | ((v << 8) & 0xff0000u) | (v << 24);
+}
+
+/* g_eac as an EAC R11 block, its two words in memory order. */
+uvec2 eac_encode()
+{
+    vec4 lo4 = min(min(g_eac[0], g_eac[1]), min(g_eac[2], g_eac[3]));
+    vec4 hi4 = max(max(g_eac[0], g_eac[1]), max(g_eac[2], g_eac[3]));
+    float lo = min(min(lo4.x, lo4.y), min(lo4.z, lo4.w)), hi = max(max(hi4.x, hi4.y), max(hi4.z, hi4.w));
+    float best = 1e30;
+    int bb = 0, bm = 0;
+    uint bs = 0u;
+    for (uint s = 0u; s < 16u && best > 0.0; s++) {
+        vec4 m = eac_magnitudes(EAC_SETS[s]);
+        float low = -m.w, high = m.w - 1.0;   /* the set's most negative and most positive modifiers */
+        int spanning = int(round((hi - lo) / ((high - low) * 8.0)));
+        for (int k = max(spanning - 2, 0); k <= min(spanning + 2, 15); k++) {
+            float step = k == 0 ? 1.0 : float(k * 8);
+            int base = clamp(int(round((0.5 * (lo + hi) - 0.5 * (low + high) * step - 4.0) / 8.0)), 0, 255);
+            float error = eac_error(base, k, EAC_SETS[s]);
+            if (error < best) { best = error; bb = base; bm = k; bs = s; }
+        }
+    }
+    int centred = bb;
+    for (int b = max(centred - 1, 0); b <= min(centred + 1, 255) && best > 0.0; b += 2) {
+        float error = eac_error(b, bm, EAC_SETS[bs]);
+        if (error < best) { best = error; bb = b; }
+    }
+    /* Each texel's modifier, 3 bits at 45 - 3 * (x * 4 + y) of the 48 below the header. */
+    vec4 neg, pos;
+    eac_values(bb, bm, EAC_SETS[bs], neg, pos);
+    uint top = (uint(bb) << 24) | (uint(bm) << 20) | (bs << 16), low = 0u;
+    for (uint t = 0u; t < 16u; t++) {
+        float v = g_eac[t >> 2u][t & 3u];
+        vec4 a = vec4(v) - neg, b = vec4(v) - pos;
+        a *= a;
+        b *= b;
+        uint pick = 0u;
+        float nearest = a.x;
+        if (a.y < nearest) { nearest = a.y; pick = 1u; }
+        if (a.z < nearest) { nearest = a.z; pick = 2u; }
+        if (a.w < nearest) { nearest = a.w; pick = 3u; }
+        if (b.x < nearest) { nearest = b.x; pick = 4u; }
+        if (b.y < nearest) { nearest = b.y; pick = 5u; }
+        if (b.z < nearest) { nearest = b.z; pick = 6u; }
+        if (b.w < nearest) { pick = 7u; }
+        uint at = 45u - 3u * ((t & 3u) * 4u + (t >> 2u));   /* t is row-major, as BC4's texels */
+        if (at >= 32u) top |= pick << (at - 32u);
+        else {
+            low |= pick << at;
+            if (at > 29u) top |= pick >> (32u - at);
+        }
+    }
+    return uvec2(eac_bytes(top), eac_bytes(low));
+}
+
+/* A BC4 block's channel into g_eac: its eight values (or six, 0 and 255) unrounded, 0..255 as 0..2047. Indices are 3
+ * bits each from bit 16 of the 64-bit block. */
+void bc4_channel(uint w0, uint w1)
+{
+    float r0 = float(w0 & 0xffu), r1 = float((w0 >> 8) & 0xffu);
+    float p[8];
+    p[0] = r0;
+    p[1] = r1;
+    if (r0 > r1) {
+        for (int k = 1; k <= 6; k++) p[k + 1] = (float(7 - k) * r0 + float(k) * r1) / 7.0;
+    } else {
+        for (int k = 1; k <= 4; k++) p[k + 1] = (float(5 - k) * r0 + float(k) * r1) / 5.0;
+        p[6] = 0.0;
+        p[7] = 255.0;
+    }
+    for (uint t = 0u; t < 16u; t++) {
+        uint at = 16u + 3u * t;
+        uint v = at >= 32u ? w1 >> (at - 32u) : (w0 >> at) | (at > 29u ? w1 << (32u - at) : 0u);
+        g_eac[t >> 2u][t & 3u] = p[v & 7u] * (2047.0 / 255.0);
+    }
+}
 )GLSL";
 
