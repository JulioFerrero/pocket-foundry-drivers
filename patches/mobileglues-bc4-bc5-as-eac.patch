+// A BC4 block's 16 values, row-major, unrounded on 0..255: as the GPU encoder decodes it (bc4_channel).
+void bc4_values(const uint8_t* b, float out[16]) {
+    const float r0 = b[0], r1 = b[1];
+    float p[8] = {r0, r1};
+    if (r0 > r1) {
+        for (int k = 1; k <= 6; k++) p[k + 1] = ((7 - k) * r0 + k * r1) / 7;
+    } else {
+        for (int k = 1; k <= 4; k++) p[k + 1] = ((5 - k) * r0 + k * r1) / 5;
+        p[6] = 0;
+        p[7] = 255;
+    }
+    uint64_t bits = 0;
+    for (int k = 0; k < 6; k++) bits |= (uint64_t)b[2 + k] << (8 * k);
+    for (int t = 0; t < 16; t++) out[t] = p[(bits >> (3 * t)) & 7];
+}
+
+// Whether BC4 and BC5 encoded as EAC draw as they decode: a 64x8 level of each, of blocks with all-zero, all-255,
+// both of BC4's ramps and random endpoints and indices, encoded as the game's would be and drawn back. [detail]: how
+// far off they came, on 0..255. EAC can't take every BC4 block exactly (its steps aren't even), so a few off is right;
+// blocks in the wrong place or the wrong byte order are far off.
+bool eac_drawn_right(Encoder& encoder, std::string& detail) {
+    const int W = 64, H = 8, bw = W / 4, bh = H / 4, n = bw * bh;
+    uint32_t seed = 0x9e3779b9u;
+    auto next = [&seed]() { seed = seed * 1664525u + 1013904223u; return (uint8_t)(seed >> 24); };
+    std::vector<uint8_t> bc4((size_t)n * 8), bc5((size_t)n * 16);
+    for (uint8_t& byte : bc4) byte = next();
+    for (uint8_t& byte : bc5) byte = next();
+    const uint8_t fixed[4][2] = {{0, 0}, {255, 255}, {0, 255}, {255, 0}};
+    for (int i = 0; i < 4; i++) {
+        bc4[i * 8] = fixed[i][0];
+        bc4[i * 8 + 1] = fixed[i][1];
+    }
+    for (int k = 2; k < 8; k++) bc4[k] = 0;   // the all-zero block: index 0 everywhere
+    double worst = 0, sum = 0;
+    size_t count = 0;
+    std::string why;
+    GLint bound = 0;
+    GLES.glGetIntegerv(GL_TEXTURE_BINDING_2D, &bound);
+    for (int two = 0; two < 2 && why.empty(); two++) {
+        const GLenum format = two ? GL_COMPRESSED_RG11_EAC : GL_COMPRESSED_R11_EAC;
+        const size_t out = two ? 16 : 8;
+        const std::vector<uint8_t>& blocks = two ? bc5 : bc4;
+        GLuint texture = 0;
+        GLES.glGenTextures(1, &texture);
+        GLES.glBindTexture(GL_TEXTURE_2D, texture);
+        while (GLES.glGetError() != GL_NO_ERROR) {}
+        std::vector<uint8_t> zeros((size_t)n * out);
+        GLES.glCompressedTexImage2D(GL_TEXTURE_2D, 0, format, W, H, 0, (GLsizei)zeros.size(), zeros.data());
+        if (GLES.glGetError() != GL_NO_ERROR) why = "the level wasn't made";
+        std::vector<uint8_t> rgba;
+        if (why.empty()) {
+            const Job job{texture, GL_TEXTURE_2D, format, 0, 0, 0, W, H, two ? 5u : 4u, (GLuint)bw, (GLuint)bh, 0, 0,
+                          false, out};
+            const size_t before = encoded;
+            run(encoder, {job}, blocks.data(), blocks.size(), (size_t)n * out / 4);
+            if (encoded == before) why = "the upload failed";
+            else draw_back(texture, 0, 0, W, H, rgba, why);
+        }
+        for (int b = 0; b < n && why.empty(); b++) {
+            for (int c = 0; c <= two; c++) {
+                float want[16];
+                bc4_values(blocks.data() + (size_t)b * (two ? 16 : 8) + c * 8, want);
+                for (int t = 0; t < 16; t++) {
+                    const int x = (b % bw) * 4 + t % 4, y = (b / bw) * 4 + t / 4;
+                    const double off = fabs(rgba[((size_t)y * W + x) * 4 + c] - want[t]);
+                    worst = std::max(worst, off);
+                    sum += off;
+                    count++;
+                }
+            }
+        }
+        GLES.glDeleteTextures(1, &texture);
+    }
+    GLES.glBindTexture(GL_TEXTURE_2D, (GLuint)bound);
+    while (GLES.glGetError() != GL_NO_ERROR) {}
+    if (!why.empty()) {
+        detail = why;
+        return false;
+    }
+    const double mean = count ? sum / count : 0;
+    char text[96];
+    snprintf(text, sizeof text, "drawn back %.1f off on average, %.0f at most, of 255", mean, worst);
+    detail = text;
+    return mean <= 4 && worst <= 40;
+}
